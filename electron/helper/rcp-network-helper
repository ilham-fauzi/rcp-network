#!/bin/sh
# RCP Network privileged helper.
#
# Installed once, root-owned, at a fixed path and allowed through a single
# sudoers rule (NOPASSWD, this file only). The app runs every privileged
# action as `sudo -n <this file> <command>`, so it never needs the person's
# password after setup.
#
#   --version                     print HELPER_VERSION
#   connect <config> <auth-file>  start OpenVPN for a config in ~/.rcp-network
#   disconnect <config>           stop the OpenVPN started for that config
#   disconnect-all                stop every OpenVPN this helper started
#   flush-dns                     flush the system DNS cache
#
# OpenVPN runs only from a binary the user cannot change: the binary, every
# library it loads outside /usr/lib and /System, and every folder above them
# must be owned by root and not writable by group or others. On macOS that is
# only the private copy that setup makes in $MAC_BUNDLE_DIR.
#
# Every refusal exits 2 and prints "refused: <reason>" on stderr.
#
# POSIX sh on purpose: macOS ships bash 3.2 and Linux may have no bash.

HELPER_VERSION=3

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH DYLD_FALLBACK_LIBRARY_PATH
umask 077

FORBIDDEN_DIRECTIVES="plugin up down route-up route-pre-down ipchange learn-address tls-verify auth-user-pass-verify client-connect client-disconnect config cd chroot log log-append status writepid management iproute tls-crypt-v2-verify"

# Linux only; macOS uses the private copy alone.
OPENVPN_CANDIDATES="/opt/homebrew/sbin/openvpn /usr/local/sbin/openvpn /usr/sbin/openvpn /usr/local/bin/openvpn /usr/bin/openvpn"

MAC_BUNDLE_DIR=/Library/PrivilegedHelperTools/rcp-network

refuse() {
  echo "refused: $*" >&2
  exit 2
}

OS=$(uname -s)
RUN_UID=$(id -u)
DRY_RUN=0

# Test mode: only honoured when not root, so it opens no bypass.
#   RCP_HELPER_TEST_TRUSTED_UID    also trusted as owner, next to uid 0
#   RCP_HELPER_TEST_OPENVPN_BUNDLE replaces $MAC_BUNDLE_DIR on macOS
#   RCP_HELPER_TEST_PID_DIR        an existing folder used as the PID folder
TRUSTED_UID=0
TEST_PID_DIR=
if [ "$RUN_UID" -ne 0 ]; then
  case ${RCP_HELPER_TEST_TRUSTED_UID:-} in
    ''|*[!0-9]*) ;;
    *) TRUSTED_UID=$RCP_HELPER_TEST_TRUSTED_UID ;;
  esac
  [ -n "${RCP_HELPER_TEST_OPENVPN_BUNDLE:-}" ] && MAC_BUNDLE_DIR=$RCP_HELPER_TEST_OPENVPN_BUNDLE
  TEST_PID_DIR=${RCP_HELPER_TEST_PID_DIR:-}
fi

# --- whose files are allowed -------------------------------------------------

resolve_user() {
  if [ "$RUN_UID" -eq 0 ]; then
    uid=${SUDO_UID:-0}
  else
    uid=$RUN_UID
  fi
  case $uid in
    ''|*[!0-9]*) refuse "invalid invoking uid" ;;
  esac
  TARGET_UID=$uid
  TARGET_USER=$(id -nu "$uid" 2>/dev/null) || refuse "unknown user $uid"
  [ -n "$TARGET_USER" ] || refuse "unknown user $uid"

  # Test mode: only honoured when not root, so it opens no bypass.
  if [ "$RUN_UID" -ne 0 ] && [ -n "$RCP_HELPER_TEST_HOME" ]; then
    TARGET_HOME=$RCP_HELPER_TEST_HOME
  elif [ "$OS" = Darwin ]; then
    TARGET_HOME=$(dscl . -read "/Users/$TARGET_USER" NFSHomeDirectory 2>/dev/null | sed -n 's/^NFSHomeDirectory: *//p')
  else
    TARGET_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
  fi
  [ -n "$TARGET_HOME" ] || refuse "no home folder for $TARGET_USER"

  ALLOWED_DIR=$(real_path "$TARGET_HOME/.rcp-network") || refuse "no ~/.rcp-network folder"
  [ -d "$ALLOWED_DIR" ] || refuse "~/.rcp-network is not a folder"
}

# --- paths --------------------------------------------------------------------

# Print the real path of $1 (symlinks resolved). Fails if it does not exist.
real_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1" 2>/dev/null
    return
  fi
  # Old macOS has no realpath: follow symlinks by hand, then pwd -P.
  p=$1
  n=0
  while [ -L "$p" ]; do
    n=$((n + 1))
    [ "$n" -le 40 ] || return 1
    t=$(readlink "$p") || return 1
    case $t in
      /*) p=$t ;;
      *) p=$(dirname "$p")/$t ;;
    esac
  done
  [ -e "$p" ] || return 1
  d=$(cd -P "$(dirname "$p")" 2>/dev/null && pwd -P) || return 1
  b=$(basename "$p")
  if [ -d "$p" ]; then
    (cd -P "$p" 2>/dev/null && pwd -P)
  elif [ "$d" = / ]; then
    printf '/%s\n' "$b"
  else
    printf '%s/%s\n' "$d" "$b"
  fi
}

# Print the real path of $2 after checking it is a regular file directly
# inside the allowed folder. $1 names the file in refusal messages.
checked_file() {
  [ -n "$2" ] || refuse "$1 path missing"
  r=$(real_path "$2") || refuse "$1 not found"
  [ "$(dirname "$r")" = "$ALLOWED_DIR" ] || refuse "$1 is outside ~/.rcp-network"
  [ -f "$r" ] && [ ! -L "$r" ] || refuse "$1 is not a regular file"
  printf '%s\n' "$r"
}

hash_id() {
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum -a 256 | cut -c1-32
  else
    printf '%s' "$1" | sha256sum | cut -c1-32
  fi
}

# --- trusted OpenVPN ------------------------------------------------------------

# Prints "<uid> <octal mode>" for $1 (not following a final symlink).
owner_mode() {
  if [ "$OS" = Darwin ]; then
    stat -f '%u %Lp' "$1"
  else
    stat -c '%u %a' "$1"
  fi
}

# Passes when the real path of $1 and every folder above it, up to /, are
# owned by root and not writable by group or others.
check_trusted() {
  p=$(real_path "$1") || return 1
  while :; do
    set -- $(owner_mode "$p" 2>/dev/null)
    [ $# -eq 2 ] || return 1
    case $2 in
      ''|*[!0-7]*) return 1 ;;
    esac
    [ "$1" = 0 ] || [ "$1" = "$TRUSTED_UID" ] || return 1
    [ $(( 0$2 & 022 )) -eq 0 ] || return 1
    [ "$p" = / ] && return 0
    p=$(dirname "$p")
  done
}

# Passes when every library $1 loads is a system library or is itself
# trusted. On macOS a bundled library must be an @loader_path/../lib/ name
# that resolves inside the binary's own bundle (<bundle>/bin/openvpn).
check_libs() {
  bin=$(real_path "$1") || return 1
  if [ "$OS" = Darwin ]; then
    bundle_lib=$(dirname "$(dirname "$bin")")/lib
    todo=$bin
    done_list=
    while [ -n "$todo" ]; do
      f=${todo%%"
"*}
      case $todo in
        *"
"*) todo=${todo#*"
"} ;;
        *) todo= ;;
      esac
      case "
$done_list
" in
        *"
$f
"*) continue ;;
      esac
      done_list="$done_list
$f"
      libs=$(otool -L "$f" 2>/dev/null) || return 1
      libs=$(printf '%s\n' "$libs" | awk '/^[ \t]/ { print $1 }')
      [ -n "$libs" ] || return 1
      for lib in $libs; do
        case $lib in
          /usr/lib/*|/System/*) ;;
          @loader_path/../lib/*)
            leaf=${lib#@loader_path/../lib/}
            case $leaf in
              ''|*/*) return 1 ;;
            esac
            r=$(real_path "$(dirname "$f")/../lib/$leaf") || return 1
            [ "$(dirname "$r")" = "$(real_path "$bundle_lib")" ] || return 1
            check_trusted "$r" || return 1
            todo="$todo${todo:+
}$r"
            ;;
          *) return 1 ;;
        esac
      done
    done
    return 0
  fi
  out=$(ldd "$bin" 2>/dev/null) || return 1
  printf '%s\n' "$out" | grep -q 'not found' && return 1
  for lib in $(printf '%s\n' "$out" | awk '
    $2 == "=>" && $3 ~ /^\// { print $3; next }
    $1 ~ /^\// { print $1 }'); do
    check_trusted "$lib" || return 1
  done
  return 0
}

# The binary must be trusted before ldd or otool look into it.
check_openvpn() {
  [ -f "$1" ] && [ -x "$1" ] || return 1
  check_trusted "$1" && check_libs "$1"
}

# Prints the OpenVPN to run. macOS: only the private copy. Linux: the first
# entry of the fixed list that passes the checks.
find_openvpn() {
  if [ "$OS" = Darwin ]; then
    c=$MAC_BUNDLE_DIR/bin/openvpn
    [ -e "$c" ] || refuse "OpenVPN copy not found at $c; run setup again"
    check_openvpn "$c" || refuse "untrusted openvpn $c"
    printf '%s\n' "$c"
    return 0
  fi
  untrusted=
  for c in $OPENVPN_CANDIDATES; do
    [ -f "$c" ] && [ -x "$c" ] || continue
    if check_openvpn "$c"; then
      printf '%s\n' "$c"
      return 0
    fi
    untrusted=${untrusted:-$c}
  done
  [ -z "$untrusted" ] || refuse "untrusted openvpn $untrusted"
  refuse "OpenVPN not found in the fixed locations"
}

owner_uid() {
  if [ "$OS" = Darwin ]; then
    stat -f %u "$1"
  else
    stat -c %u "$1"
  fi
}

prepare_pid_dir() {
  if [ "$DRY_RUN" -eq 1 ]; then
    PID_DIR=$(mktemp -d "${TMPDIR:-/tmp}/rcp-network-helper.XXXXXX") || refuse "cannot create temp folder"
    trap 'rm -rf "$PID_DIR"' EXIT
    return
  fi
  if [ -n "$TEST_PID_DIR" ]; then
    PID_DIR=$TEST_PID_DIR
    [ -d "$PID_DIR" ] && [ ! -L "$PID_DIR" ] || refuse "$PID_DIR is not a folder"
    [ "$(owner_uid "$PID_DIR")" = "$RUN_UID" ] || refuse "$PID_DIR is not owned by the user"
    return
  fi
  [ "$RUN_UID" -eq 0 ] || refuse "must run as root (through sudo -n)"
  if [ "$OS" = Darwin ]; then
    PID_DIR=/var/run/rcp-network
  else
    PID_DIR=/run/rcp-network
  fi
  if [ -L "$PID_DIR" ]; then
    refuse "$PID_DIR is a symlink"
  fi
  if [ ! -d "$PID_DIR" ]; then
    mkdir -m 700 "$PID_DIR" || refuse "cannot create $PID_DIR"
  fi
  chown 0 "$PID_DIR" && chmod 700 "$PID_DIR" || refuse "cannot secure $PID_DIR"
  [ "$(owner_uid "$PID_DIR")" = 0 ] || refuse "$PID_DIR is not owned by root"
}

# Copy $1 to $2 reading it with the invoking user's rights, so a file swapped
# after the checks can only expose what the user could already read.
copy_as_user() {
  rm -f "$2"
  if [ "$RUN_UID" -eq 0 ] && [ "$TARGET_UID" -ne 0 ]; then
    sudo -n -u "#$TARGET_UID" /bin/cat -- "$1" > "$2" || return 1
  else
    /bin/cat -- "$1" > "$2" || return 1
  fi
  chmod 600 "$2"
}

# Print the first forbidden directive found in $1, if any. Checks every
# non-comment line, after leading whitespace, an optional leading "--", and
# inline "<directive>" block tags; case-insensitive.
forbidden_directive() {
  awk -v list="$FORBIDDEN_DIRECTIVES" '
    BEGIN { n = split(list, a, " "); for (i = 1; i <= n; i++) bad[a[i]] = 1 }
    {
      line = $0
      sub(/\r$/, "", line)
      sub(/^[ \t\f\v]+/, "", line)
      if (line == "" || line ~ /^[#;]/) next
      tok = line
      sub(/[ \t\f\v].*$/, "", tok)
      gsub(/["\047\\]/, "", tok)
      sub(/^<\/?/, "", tok)
      sub(/>.*$/, "", tok)
      sub(/^--/, "", tok)
      tok = tolower(tok)
      if (tok in bad) { print tok; exit 1 }
    }' "$1"
}

# --- stopping -----------------------------------------------------------------

# sh has no local variables: the helpers below use their own _xx_ prefixed
# names so they never overwrite a caller's (cmd_connect's id once did, and
# connecting a second profile stopped the first).

remove_entry() {
  rm -f "$PID_DIR/$1.pid" "$PID_DIR/$1.conf" "$PID_DIR/$1.auth"
}

# Prints the PID recorded for entry $1 if that process is an openvpn.
running_pid() {
  _rp_f="$PID_DIR/$1.pid"
  [ -f "$_rp_f" ] || return 1
  _rp_pid=$(head -n 1 "$_rp_f" | tr -d ' \r\n')
  case $_rp_pid in
    ''|*[!0-9]*) return 1 ;;
  esac
  _rp_comm=$(ps -p "$_rp_pid" -o comm= 2>/dev/null) || return 1
  _rp_comm=$(printf '%s' "$_rp_comm" | tr -d ' \n')
  [ "${_rp_comm##*/}" = openvpn ] || return 1
  printf '%s\n' "$_rp_pid"
}

stop_entry() {
  if _se_pid=$(running_pid "$1"); then
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "kill -TERM $_se_pid"
    else
      kill -TERM "$_se_pid" 2>/dev/null
    fi
  fi
  remove_entry "$1"
}

# Remove leftovers of OpenVPN runs that ended on their own.
collect_stale() {
  for _cs_f in "$PID_DIR"/*.pid "$PID_DIR"/*.conf; do
    [ -e "$_cs_f" ] || continue
    _cs_b=$(basename "$_cs_f")
    _cs_id=${_cs_b%.*}
    running_pid "$_cs_id" >/dev/null || remove_entry "$_cs_id"
  done
}

# --- commands -----------------------------------------------------------------

cmd_connect() {
  [ $# -eq 2 ] || refuse "usage: connect <config> <auth-file>"
  resolve_user
  config=$(checked_file config "$1") || exit 2
  auth=$(checked_file "auth file" "$2") || exit 2

  prepare_pid_dir
  if [ "$DRY_RUN" -eq 0 ]; then
    collect_stale
  fi
  # After the cleanup, so the entry stopped and written is always this config's
  id=$(hash_id "$config")
  if [ "$DRY_RUN" -eq 0 ]; then
    stop_entry "$id"
  fi

  conf_copy="$PID_DIR/$id.conf"
  auth_copy="$PID_DIR/$id.auth"
  copy_as_user "$config" "$conf_copy" || { remove_entry "$id"; refuse "cannot read config"; }
  copy_as_user "$auth" "$auth_copy" || { remove_entry "$id"; refuse "cannot read auth file"; }

  if ! bad=$(forbidden_directive "$conf_copy"); then
    remove_entry "$id"
    refuse "config uses forbidden directive '$bad'"
  fi

  openvpn=$(find_openvpn) || { remove_entry "$id"; exit 2; }

  cd "$ALLOWED_DIR" || refuse "cannot enter ~/.rcp-network"

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "$openvpn --config $conf_copy --script-security 1 --auth-user-pass $auth_copy --writepid $PID_DIR/$id.pid"
    exit 0
  fi

  exec "$openvpn" --config "$conf_copy" --script-security 1 \
    --auth-user-pass "$auth_copy" --writepid "$PID_DIR/$id.pid"
}

cmd_disconnect() {
  [ $# -eq 1 ] || refuse "usage: disconnect <config>"
  resolve_user
  [ -n "$1" ] || refuse "config path missing"
  if [ -e "$1" ] || [ -L "$1" ]; then
    config=$(checked_file config "$1") || exit 2
  else
    # The file may be gone since connect; the folder must still be ours.
    d=$(real_path "$(dirname "$1")") || refuse "config is outside ~/.rcp-network"
    [ "$d" = "$ALLOWED_DIR" ] || refuse "config is outside ~/.rcp-network"
    config="$d/$(basename "$1")"
  fi
  prepare_pid_dir
  stop_entry "$(hash_id "$config")"
  exit 0
}

cmd_disconnect_all() {
  [ $# -eq 0 ] || refuse "usage: disconnect-all"
  prepare_pid_dir
  for _da_f in "$PID_DIR"/*.pid; do
    [ -e "$_da_f" ] || continue
    _da_b=$(basename "$_da_f")
    stop_entry "${_da_b%.pid}"
  done
  collect_stale
  exit 0
}

cmd_flush_dns() {
  [ $# -eq 0 ] || refuse "usage: flush-dns"
  if [ "$OS" = Darwin ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "dscacheutil -flushcache; killall -HUP mDNSResponder"
      exit 0
    fi
    [ "$RUN_UID" -eq 0 ] || refuse "must run as root (through sudo -n)"
    dscacheutil -flushcache
    killall -HUP mDNSResponder
    exit 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "resolvectl flush-caches || systemd-resolve --flush-caches"
    exit 0
  fi
  [ "$RUN_UID" -eq 0 ] || refuse "must run as root (through sudo -n)"
  if command -v resolvectl >/dev/null 2>&1 && resolvectl flush-caches; then
    exit 0
  fi
  if command -v systemd-resolve >/dev/null 2>&1 && systemd-resolve --flush-caches; then
    exit 0
  fi
  echo "no DNS cache flush tool found" >&2
  exit 1
}

# Test-only commands: report the ownership and library checks.
cmd_check() {
  [ "$RUN_UID" -ne 0 ] || refuse "test command not available as root"
  [ $# -eq 1 ] || refuse "usage: $cmd <path>"
  case $cmd in
    check-trusted) check_trusted "$1" ;;
    check-libs) check_libs "$1" ;;
  esac || refuse "untrusted $1"
  exit 0
}

# --- main ---------------------------------------------------------------------

if [ "${1:-}" = "--dry-run" ]; then
  # Test mode: only honoured when not root.
  [ "$RUN_UID" -ne 0 ] && DRY_RUN=1
  shift
fi

cmd=${1:-}
[ $# -gt 0 ] && shift

case $cmd in
  --version) echo "$HELPER_VERSION" ;;
  connect) cmd_connect "$@" ;;
  disconnect) cmd_disconnect "$@" ;;
  disconnect-all) cmd_disconnect_all "$@" ;;
  flush-dns) cmd_flush_dns "$@" ;;
  check-trusted|check-libs) cmd_check "$@" ;;
  *) refuse "unknown command '$cmd'" ;;
esac
